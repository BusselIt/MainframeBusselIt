# ---- Algemeen ----
PORT=3000
# Wachtwoord voor het dashboard (Basic Auth, gebruiker: admin). Leeg = geen login (alleen lokaal!)
DASHBOARD_PASSWORD=
# DEMO_MODE=true vult het dashboard met voorbeelddata en schakelt echte koppelingen uit
DEMO_MODE=true

# ---- AI (offerte-inschatting) ----
# Zonder sleutel gebruikt de mainframe een eenvoudige regel-gebaseerde inschatting.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ---- e-Boekhouden.nl (REST API) ----
# Aanmaken in e-Boekhouden: Beheer > Inrichting > Instellingen > Koppelingen > API/SOAP
EBOEKHOUDEN_ACCESS_TOKEN=
EBOEKHOUDEN_SOURCE=BusselITMainframe

# ---- Office 365 / Microsoft Graph ----
# App-registratie in Entra ID met application permission Mail.ReadWrite (+ admin consent)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Mailbox waarop klantaanvragen binnenkomen
MS_MAILBOX=info@busselit.com
MAIL_POLL_MINUTES=5

# ---- Website-koppeling (busselit.com formulieren) ----
# Gedeeld geheim; website stuurt header  X-Webhook-Secret: <waarde>
WEBSITE_WEBHOOK_SECRET=
